@page "/project/{Key}"
@using NightOwl.Core.Ai
@inject ReportArchive Archive
@inject ScanHistory History
@inject ScanVault Vault
@inject NightOwl.Web.StigStore Stigs

<PageTitle>@(_report is null ? "Not found" : System.IO.Path.GetFileName(_report.Project)) · Night Owl</PageTitle>

@if (_report is null)
{
    <div class="card"><h2>Project not found</h2><a href="/">Back to all projects</a></div>
    return;
}

<header class="page-head">
    <div>
        <p class="crumb"><a href="/projects">Projects</a> /</p>
        <h1>@System.IO.Path.GetFileName(_report.Project)</h1>
        <p class="muted path">@_report.Project</p>
        <TagEditor @key="_report.Project" Project="@_report.Project" />
    </div>
    <p class="muted right">
        Scanned @_report.StartedAt.ToLocalTime().ToString("g") in @_report.Seconds.ToString("0.0")s<br />
        manifest #@_report.ManifestSequence
    </p>
</header>

<nav class="tabs" aria-label="Project sections">
    <a href="@Url(null)" class="@(Tab == "summary" ? "active" : "")">Summary</a>
    <a href="@Url("findings")" class="@(Tab == "findings" ? "active" : "")">Findings <span class="pill">@_report.Findings.Count</span></a>
    <a href="@Url("scans")" class="@(Tab == "scans" ? "active" : "")">Scans <span class="pill">@_scans.Count</span></a>
    <a href="@Url("export")" class="@(Tab == "export" ? "active" : "")">Export</a>
</nav>

@if (_viewingOlder)
{
    <div class="banner">Viewing the scan from <b>@_report.StartedAt.ToLocalTime().ToString("g")</b>@(ScanLabel is { } l ? $" ({l})" : ""), not the latest. <a href="/project/@Key">Back to the latest scan</a></div>
}

@if (Tab == "summary")
{
<section class="kpis">
    <div class="kpi kpi-critical"><span>Critical</span><b>@ReportStats.Count(_counts, Severity.Critical)</b></div>
    <div class="kpi kpi-high"><span>High</span><b>@ReportStats.Count(_counts, Severity.High)</b></div>
    <div class="kpi"><span>Medium</span><b>@ReportStats.Count(_counts, Severity.Medium)</b></div>
    <div class="kpi"><span>Low</span><b>@(ReportStats.Count(_counts, Severity.Low) + ReportStats.Count(_counts, Severity.Info))</b></div>
</section>

<section class="grid-2">
    <div class="card"><h3>Open findings by severity</h3><SeverityDonut Counts="_counts" /></div>
    <div class="card"><h3>By category</h3><BarList Items="_byCategory" /></div>
</section>

<div class="card">
    @if (_report.Metrics is { Count: > 0 } metrics)
    {
        <dl class="metrics">
            @foreach (var (key, value) in metrics.OrderBy(m => m.Key, StringComparer.Ordinal))
            {
                <div><dt>@NightOwl.Core.Quality.MetricNames.Label(key)</dt><dd>@NightOwl.Core.Quality.MetricNames.Format(key, value)</dd></div>
            }
        </dl>
    }
    @if (_history.Count > 1)
    {
        <TrendChart Points="_history" />
    }
    @if (_report.Findings.Any(f => f.Assessment is not null))
    {
        <p class="counts ai-counts">
            <span class="muted">AI pen-test review:</span>
            @foreach (var group in _report.Findings.Where(f => f.Assessment is not null).GroupBy(f => f.Assessment!.Verdict).OrderByDescending(g => g.Key))
            {
                <a class="ai-badge ai-@group.Key" href="@($"/project/{Key}?ai={group.Key}")">@group.Count() @AiAssessment.Label(group.Key)</a>
            }
        </p>
    }
    @if (_report.Pentest is { } pentest)
    {
        <div class="pentest">
            <p>
                <strong>Active test</strong> authorized by @pentest.AuthorizedBy
                (<code>@pentest.AuthorizationReference</code>, valid until @pentest.AuthorizationExpires.ToLocalTime().ToString("g"))
            </p>
            <p class="muted">
                @if (pentest.AuthenticatedWithHeader is { } header) { <text>authenticated (@header header) · </text> }
                @if (pentest.OpenApi is { } spec) { <text>API scan from <code>@System.IO.Path.GetFileName(spec)</code> (@(pentest.ActiveScan ? "active" : "safe mode")) · </text> }
                @pentest.RequestsAllowed requests sent · @pentest.RequestsBlocked blocked by scope ·
                scope <code title="SHA-256 of the scope file">@pentest.ScopeSha256[..12]</code> ·
                log <code>@pentest.RequestLog</code>
            </p>
            @if (pentest.Correlations.Count > 0)
            {
                <h4 class="corr-title">Static findings checked by this test</h4>
                <ul class="correlations">
                    @foreach (var c in pentest.Correlations)
                    {
                        <li>
                            <span class="corr corr-@c.Status">@c.Status</span>
                            <strong>@c.StaticTitle</strong>
                            <span class="muted">@c.Explanation</span>
                        </li>
                    }
                </ul>
            }
            @if (pentest.Plan is { } plan)
            {
                <details>
                    <summary>Plan by @plan.PlannedBy: @string.Join(", ", plan.NucleiTags)@(plan.FocusPaths.Count > 0 ? $" · {plan.FocusPaths.Count} focus paths" : "")</summary>
                    <div class="ai-body">
                        @if (plan.Rationale is { } why) { <p>@why</p> }
                        @if (plan.FocusPaths.Count > 0) { <p>Focus: @foreach (var path in plan.FocusPaths) { <code>@path</code><text> </text> }</p> }
                        @foreach (var h in plan.Hypotheses) { <p>Tests static finding <code>@h.StaticFindingId[..Math.Min(12, h.StaticFindingId.Length)]</code>: @h.Test</p> }
                        @if (plan.Rejected.Count > 0)
                        {
                            <h4>Refused by scope or allowlist</h4>
                            <ul>@foreach (var r in plan.Rejected) { <li>@r</li> }</ul>
                        }
                    </div>
                </details>
            }
        </div>
    }
    <h3>Engines</h3>
    <ul class="engines">
        @foreach (var e in _report.Engines)
        {
            <li class="@(e.Succeeded ? "ok" : "bad")"><b>@e.Engine</b> <span class="muted">@e.Version · @e.Seconds.ToString("0.0")s</span>@if (e.Error is not null) { <div>@e.Error</div> } @if (e.Note is not null) { <div class="muted">@e.Note</div> }</li>
        }
    </ul>
</div>
}

@if (Tab == "export")
{
<div class="card">
    <h3>Export @(_viewingOlder ? "this scan" : "the latest scan")</h3>
    <table>
        <tbody>
            @foreach (var (format, label, hint) in NightOwl.Web.ExportEndpoints.Formats)
            {
                <tr>
                    <td><b>@label</b></td>
                    <td class="muted">@hint</td>
                    <td>
                        @if (format == "ckl" && _stig is null) { <a href="/exports">Import a STIG</a> }
                        else { <a class="btn" href="@($"/export/{Key}/{format}{ExportQuery(format)}")" download>Download</a> }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
}

@if (Tab == "scans")
{
<div class="card table-wrap">
    <h3>Scan history</h3>
    <p class="muted small">Each scan is kept so you can reopen it or compare two. Add a label, such as a release version, with the button in the row or <code>nightowl scan --label v1.4.0</code>. The newest @ScanVault.MaxScans are kept, plus any labelled scan.</p>
    <table>
        <thead><tr><th>Scan</th><th>Label</th><th>Open</th><th>Critical</th><th>High</th><th>Time</th><th></th></tr></thead>
        <tbody>
            @for (var i = 0; i < _scans.Count; i++)
            {
                var scan = _scans[i];
                var older = i + 1 < _scans.Count ? _scans[i + 1] : null;
                <tr class="@(scan.Id == _currentId ? "current" : "")">
                    <td>@scan.At.ToLocalTime().ToString("g") @if (i == 0) { <span class="pill">latest</span> }</td>
                    <td><ScanLabelEditor @key="scan.Id" Project="@_report.Project" ScanId="@scan.Id" Label="@scan.Label" /></td>
                    <td>@scan.Open</td>
                    <td class="@(scan.Critical > 0 ? "bad" : "")">@scan.Critical</td>
                    <td>@scan.High</td>
                    <td class="muted">@scan.Seconds.ToString("0.0")s</td>
                    <td class="actions">
                        <a href="/project/@Key?scan=@scan.Id">Open</a>
                        @if (older is not null) { <a href="/project/@Key/compare?from=@older.Id&to=@scan.Id">Changes since previous</a> }
                        @if (i > 0) { <a href="/project/@Key/compare?from=@scan.Id&to=@_scans[0].Id">Compare to latest</a> }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (_scans.Count == 0) { <p class="muted">No saved scans yet. History starts with the next scan.</p> }
</div>
}

@if (Tab == "findings")
{
<div class="card">
    <form method="get" class="filters">
        <input type="hidden" name="tab" value="findings" />
        <select name="severity">
            <option value="">Any severity</option>
            @foreach (var s in Enum.GetValues<Severity>().Reverse())
            {
                <option value="@s" selected="@(SeverityFilter == s.ToString())">@s+</option>
            }
        </select>
        <select name="category">
            <option value="">All categories</option>
            @foreach (var c in Enum.GetValues<FindingCategory>())
            {
                <option value="@c" selected="@(CategoryFilter == c.ToString())">@c</option>
            }
        </select>
        <select name="ai">
            <option value="">Any AI verdict</option>
            @foreach (var v in Enum.GetValues<Exploitability>().Reverse())
            {
                <option value="@v" selected="@(AiFilter == v.ToString())">@AiAssessment.Label(v)</option>
            }
            <option value="none" selected="@(AiFilter == "none")">Not reviewed</option>
        </select>
        <input name="q" value="@Query" placeholder="Search package, id, title" />
        <button type="submit">Filter</button>
        <span class="muted">@_visible.Count of @_report.Findings.Count</span>
    </form>

    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>Severity</th><th>Category</th><th>Id</th><th>Finding</th><th>Fix</th><th>AI review</th><th>Engines</th></tr>
            </thead>
            <tbody>
                @foreach (var f in _visible)
                {
                    <tr>
                        <td><span class="sev sev-@f.Severity">@f.Severity.ToString().ToUpperInvariant()</span></td>
                        <td>@f.Category</td>
                        <td>
                            @if (f.References.FirstOrDefault() is { } link)
                            {
                                <a href="@link" target="_blank" rel="noopener">@f.RuleId</a>
                            }
                            else
                            {
                                @f.RuleId
                            }
                        </td>
                        <td>
                            @f.Title
                            @if (f.Location?.Path is { } path)
                            {
                                <div class="muted"><code>@path</code></div>
                            }
                            @if (f.Context != FindingContext.Production)
                            {
                                <span class="ctx" title="Does not fail the gate by default">@f.Context.ToString().ToLowerInvariant()</span>
                            }
                            <TriageButtons @key="f.Id" Project="@_report.Project" Finding="f" />
                        </td>
                        <td>@string.Join(" / ", f.FixedVersions)</td>
                        <td class="ai-cell"><AiAssessment Assessment="f.Assessment" /></td>
                        <td class="muted">@string.Join(", ", f.Engines)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
}

@code {
    [Parameter] public string Key { get; set; } = "";
    [SupplyParameterFromQuery(Name = "severity")] public string? SeverityFilter { get; set; }
    [SupplyParameterFromQuery(Name = "category")] public string? CategoryFilter { get; set; }
    [SupplyParameterFromQuery(Name = "ai")] public string? AiFilter { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? TabParam { get; set; }
    [SupplyParameterFromQuery(Name = "scan")] public string? ScanParam { get; set; }

    private List<ScanInfo> _scans = [];
    private string? _currentId;
    private bool _viewingOlder;
    private string? _stig;

    private string ExportQuery(string format)
    {
        var query = new List<string>();
        if (_viewingOlder) { query.Add("scan=" + _currentId); }
        if (format == "ckl" && _stig is not null) { query.Add("stig=" + Uri.EscapeDataString(_stig)); }
        return query.Count == 0 ? "" : "?" + string.Join("&", query);
    }
    private string? ScanLabel => _scans.FirstOrDefault(s => s.Id == _currentId)?.Label;

    private string Url(string? tab)
    {
        var query = new List<string>();
        if (tab is not null) { query.Add($"tab={tab}"); }
        if (ScanParam is not null) { query.Add($"scan={ScanParam}"); }
        return $"/project/{Key}" + (query.Count == 0 ? "" : "?" + string.Join("&", query));
    }

    private string Tab => TabParam == "export" ? "export" : TabParam == "scans" ? "scans" : TabParam == "findings" || AiFilter is not null || SeverityFilter is not null || CategoryFilter is not null || Query is not null ? "findings" : "summary";
    private List<Finding> _open = [];
    private IReadOnlyDictionary<Severity, int> _counts = new Dictionary<Severity, int>();
    private IReadOnlyList<(string, int)> _byCategory = [];

    private ScanReport? _report;
    private IReadOnlyList<HistoryPoint> _history = [];
    private List<Finding> _visible = [];

    protected override void OnParametersSet()
    {
        var latest = Archive.LoadAll().FirstOrDefault(r => ReportArchive.KeyFor(r.Project) == Key);
        _report = latest;
        if (latest is null)
        {
            return;
        }

        _stig = Stigs.List().FirstOrDefault();
        _scans = Vault.List(latest.Project).ToList();
        if (_scans.Count == 0)
        {
            // Scanned before history existed: show the one report we have as the only entry.
            var open = ReportStats.Open(latest).ToList();
            _scans = [new ScanInfo(ScanVault.IdFor(latest), latest.StartedAt, open.Count, open.Count(f => f.Severity == Severity.Critical),
                open.Count(f => f.Severity == Severity.High), latest.Seconds, latest.ManifestSequence, null)];
        }

        _currentId = ScanVault.IdFor(latest);
        _viewingOlder = false;
        if (ScanParam is not null && Vault.Load(latest.Project, ScanParam) is { } older)
        {
            _report = older;
            _currentId = ScanParam;
            _viewingOlder = true;
        }

        _history = History.Load(_report.Project);
        _open = ReportStats.Open(_report).ToList();
        _counts = ReportStats.BySeverity(_open);
        _byCategory = _open.GroupBy(f => f.Category).OrderByDescending(g => g.Count()).Select(g => (g.Key.ToString(), g.Count())).ToList();
        IEnumerable<Finding> findings = _report.Findings;
        if (Enum.TryParse<Severity>(SeverityFilter, out var minimum))
        {
            findings = findings.Where(f => f.Severity >= minimum);
        }

        if (Enum.TryParse<FindingCategory>(CategoryFilter, out var category))
        {
            findings = findings.Where(f => f.Category == category);
        }

        if (AiFilter == "none")
        {
            findings = findings.Where(f => f.Assessment is null);
        }
        else if (Enum.TryParse<Exploitability>(AiFilter, out var verdict))
        {
            findings = findings.Where(f => f.Assessment?.Verdict == verdict);
        }

        if (!string.IsNullOrWhiteSpace(Query))
        {
            findings = findings.Where(f =>
                f.Title.Contains(Query, StringComparison.OrdinalIgnoreCase)
                || f.RuleId.Contains(Query, StringComparison.OrdinalIgnoreCase)
                || f.Aliases.Any(a => a.Contains(Query, StringComparison.OrdinalIgnoreCase))
                || (f.Package?.Name.Contains(Query, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        _visible = findings.ToList();
    }
}
