<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="NightOwl.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NightOwl.Core\NightOwl.Core.csproj" />
    <ProjectReference Include="..\NightOwl.Engines\NightOwl.Engines.csproj" />
    <ProjectReference Include="..\NightOwl.Ai\NightOwl.Ai.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>nightowl</AssemblyName>
    <RootNamespace>NightOwl.Cli</RootNamespace>
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
  </PropertyGroup>

  <!-- Release builds: dotnet publish -p:NightOwlManifestUrl=https://... with keys/nightowl-signing.pub present. -->
  <ItemGroup>
    <AssemblyMetadata Include="NightOwlManifestUrl" Value="$(NightOwlManifestUrl)" />
    <EmbeddedResource Include="../../keys/nightowl-signing.pub" LogicalName="nightowl-signing.pub" Condition="Exists('../../keys/nightowl-signing.pub')" />
  </ItemGroup>

</Project>
